rules_version = '2';

// Firebase-Projekt "social-one-gem" (Social One Gem)
// applications: Creator-Bewerbungen von one-gem-social.vercel.app

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'team@one-gem.de';
    }

    match /applications/{applicationId} {
      // Bewerbungen sieht und bearbeitet nur das Team.
      allow read, update, delete: if isAdmin();

      // Jede Person darf eine vollständige, gültige Bewerbung abschicken.
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'handle', 'age', 'city', 'about', 'consent', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[A-Za-z0-9._]{2,30}$')
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 99
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 1
        && request.resource.data.city.size() <= 100
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.status == 'neu'
        && request.resource.data.createdAt == request.time;
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
