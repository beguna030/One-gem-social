rules_version = '2';

// Gilt für das gesamte Firebase-Projekt "backstage-beguna":
// - topics: BeGuNa-Themenliste (intenbeguna.github.io/beguna-themen)
// - applications: Creator-Bewerbungen der One-Gem-Website (one-gem-social.vercel.app)

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'team@backstage-beguna.app';
    }

    match /topics/{topicId} {
      // Die Themenliste darf von allen Personen mit dem Link gelesen werden.
      allow read: if true;

      // Nur der gemeinsame Backoffice-Nutzer darf Themen anlegen oder löschen.
      allow create, delete: if isAdmin();

      // Backoffice darf verwalten. Besucher dürfen ausschließlich ein freies
      // Thema einmalig mit einem Namen sichern. Freigeben ist nur im Backoffice möglich.
      allow update: if isAdmin() || (
        resource.data.status == 'frei'
        && request.resource.data.status == 'blockiert'
        && request.resource.data.claimedBy is string
        && request.resource.data.claimedBy.size() >= 2
        && request.resource.data.claimedBy.size() <= 60
        && request.resource.data.claimedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedAt'])
      );
    }

    match /applications/{applicationId} {
      // Bewerbungen sieht und bearbeitet nur das Team.
      allow read, update, delete: if isAdmin();

      // Jede Person darf eine vollständige, gültige Bewerbung abschicken.
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'handle', 'age', 'city', 'about', 'consent', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[A-Za-z0-9._]{2,30}$')
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 99
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 1
        && request.resource.data.city.size() <= 100
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.status == 'neu'
        && request.resource.data.createdAt == request.time;
    }
  }
}
